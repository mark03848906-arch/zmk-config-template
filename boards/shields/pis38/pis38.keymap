#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // TAB   Q W E R T Y U I O P
            // LGUI  A S D F G H J K L
            // LALT  Z X C V B N M , .
            // LCTRL LOWER SPACE SPACE RAISE RALT BSPC RET ; /
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I    &kp O
                &kp LGUI  &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K    &kp L
                &kp LALT  &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT
                &kp LCTRL &mo 1 &kp SPACE &kp SPACE &mo 2 &kp RALT &kp BSPC &kp RET &kp SEMI &kp FSLH
            >;
        };

        lower_layer {
            // 숫자 / 기호   (맨 왼쪽 아래 = ADJUST 레이어 진입, 맨 오른쪽 아래 = studio_unlock)
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9   &kp N0
                &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &kp CARET &kp AMPS  &kp STAR  &kp LPAR &kp RPAR
                &kp GRAVE &kp TILDE &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &kp PIPE  &kp UNDER &kp PLUS
                &mo 3     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans   &studio_unlock
            >;
        };

        raise_layer {
            // 펑션키 / 방향키 / 블루투스   (맨 오른쪽 아래 = MEDIA 레이어 진입)
            bindings = <
                &kp F1        &kp F2        &kp F3       &kp F4       &kp F5       &kp F6   &kp F7    &kp F8    &kp F9    &kp F10
                &kp F11       &kp F12       &trans       &trans       &trans       &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans   &trans    &trans    &trans    &bt BT_CLR
                &trans        &trans        &trans       &trans       &trans       &trans   &trans    &trans    &trans    &mo 4
            >;
        };

        adjust_layer {
            // 시스템: 부트로더 진입 / 리셋 / 블루투스 전체 초기화 / USB-BLE 출력 전환
            bindings = <
                &bootloader &sys_reset &trans &trans &trans &trans &trans &trans &trans &trans
                &bt BT_CLR_ALL &out OUT_USB &out OUT_BLE &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        media_layer {
            // 미디어 컨트롤 (왼쪽) / 넘패드 (오른쪽)
            bindings = <
                &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PP &trans &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MINUS &trans
                &trans     &trans       &trans       &trans   &trans &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS  &trans
                &trans     &trans       &trans       &trans   &trans &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER &trans
                &trans     &trans       &trans       &trans   &trans &trans    &trans    &trans    &kp KP_N0    &trans
            >;
        };
    };
};
