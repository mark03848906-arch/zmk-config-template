#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        col-gpios
            = <&pro_micro 6 GPIO_ACTIVE_HIGH>    // col 0 = D6
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>    // col 1 = D7
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>    // col 2 = D8
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>    // col 3 = D9
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>   // col 4 = D10
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>   // col 5 = D16
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>   // col 6 = D14
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>   // col 7 = D15
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   // col 8 = D18
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>;  // col 9 = D19
        row-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 0 = D2
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 1 = D3
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 2 = D4
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // row 3 = D5
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
    };
};
